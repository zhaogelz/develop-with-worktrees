{
  "description": "Codex edit-target guard for develop-with-worktrees. Checks explicit native edit paths and task ownership; terminal commands and filesystem permissions belong to the host runtime.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"$PLUGIN_ROOT/hooks/worktree_guard.py\"",
            "commandWindows": "$env:Path = \"$env:USERPROFILE\\.local\\bin;$env:Path\"; $env:PATHEXT = \".EXE;$env:PATHEXT\"; uv run --script \"$env:PLUGIN_ROOT/hooks/worktree_guard.py\"",
            "timeout": 15,
            "statusMessage": "Checking worktree policy"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"$PLUGIN_ROOT/hooks/worktree_guard.py\"",
            "commandWindows": "$env:Path = \"$env:USERPROFILE\\.local\\bin;$env:Path\"; $env:PATHEXT = \".EXE;$env:PATHEXT\"; uv run --script \"$env:PLUGIN_ROOT/hooks/worktree_guard.py\"",
            "timeout": 15,
            "statusMessage": "Checking worktree policy"
          }
        ]
      }
    ]
  }
}
